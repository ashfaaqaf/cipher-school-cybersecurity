# Narration generation only. Never referenced by the app or the client bundle —
# audio is generated ahead of time and shipped as static files.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Canonical public origin used for metadata, robots.txt and sitemap.xml.
# Leave unset for the GitHub Pages address. Set it when building another host.
SITE_URL=
